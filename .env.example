NEXT_PUBLIC_SITE_URL=https://www.craterclaim.com
# Paste the content token from Search Console HTML-tag verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase projects
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated admin login at /admin/login — not Google/Apple/X
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Lemon Squeezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Same Web client ID as the Google provider in Supabase. Stops Google from showing supabase.co.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend — confirmation email after a landing goes live
RESEND_API_KEY=
RESEND_FROM_EMAIL=CraterClaim <noreply@yourdomain.com>

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Mock webhook fallback for local tests
WEBHOOK_SECRET=craterclaim-dev-webhook
